<section class="carbon-content">
  <header class="carbon-heading">
    <i class="fas fa-dice" aria-hidden="true"></i>
    <div><h2>Roll your next encounter</h2><p>PTU 1.05 · Pokémon Carbon</p></div>
  </header>
  <fieldset {{#if busy}}disabled{{/if}}>
    <legend>Encounter</legend>
    <label>Generate<select name="mode">{{#each modes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>Amount (Pokémon or trainers)<input type="number" name="amount" value="{{values.amount}}" min="1" max="50" step="1" required></label>
    <p class="carbon-hint">Actors are saved under <strong>Random Encounter Gen</strong>. Each trainer has a folder with a Party subfolder for their Pokémon.</p>
    <label class="carbon-checkbox"><input type="checkbox" name="placeTokens" {{#if values.placeTokens}}checked{{/if}}> Also place tokens on the open scene</label>
  </fieldset>
  {{#if showTrainers}}
  <fieldset {{#if busy}}disabled{{/if}}>
    <legend>Trainers</legend>
    <div class="carbon-grid">
      <label>Minimum trainer level<input type="number" name="trainerMinLevel" value="{{values.trainerMinLevel}}" min="1" max="50" step="1" required></label>
      <label>Maximum trainer level<input type="number" name="trainerMaxLevel" value="{{values.trainerMaxLevel}}" min="1" max="50" step="1" required></label>
    </div>
    <label>Generic game portrait and token<select name="trainerArt"><option value="">Random generic trainer</option>{{#each trainerArt}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    {{#if showParty}}<label>Pokémon per trainer<input type="number" name="partySize" value="{{values.partySize}}" min="1" max="6" step="1" required></label>{{/if}}
    {{#if showParty}}<label class="carbon-checkbox"><input type="checkbox" name="trainerHasMega" {{#if values.trainerHasMega}}checked{{/if}}> Each trainer has one Mega Pokémon (included in party size)</label>{{/if}}
    <p class="carbon-hint">Carbon's NPC builder chooses classes, features, edges and skills. Portraits and matching token textures use generic game trainers. {{#if showParty}}Pokémon levels are selected separately below.{{/if}}</p>
  </fieldset>
  {{/if}}
  {{#if showPokemon}}
  <fieldset {{#if busy}}disabled{{/if}}>
    <legend>Pokémon pool</legend>
    <label>Species compendium
      <select name="pack">{{#each packs}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <label>Species name or Pokédex number
      <input name="search" value="{{values.search}}" placeholder="Any species, or e.g. Pikachu, 133" autocomplete="off">
    </label>
    <div class="carbon-grid">
      <label>Type<select name="type"><option value="">Any type</option>{{#each types}}<option {{#if selected}}selected{{/if}} value="{{value}}">{{value}}</option>{{/each}}</select></label>
      <label>Habitat<select name="habitat"><option value="">Any habitat</option>{{#each habitats}}<option {{#if selected}}selected{{/if}} value="{{value}}">{{value}}</option>{{/each}}</select></label>
    </div>
    <label class="carbon-checkbox"><input type="checkbox" name="includeForms" {{#if values.includeForms}}checked{{/if}}> Include compendium forms</label>
    <label class="carbon-checkbox"><input type="checkbox" name="includeLegendary" {{#if values.includeLegendary}}checked{{/if}}> Include Legendary and Mythical Pokémon</label>
    <p class="carbon-hint">Legendary and Mythical species are excluded by default. Enabling them adds them to the eligible pool; it does not guarantee one. Level, species, form and Mega filters still apply.</p>
    <p class="carbon-hint">Only species items are used. Mega Pokémon are excluded unless the trainer's Mega option is checked. Species must meet their listed minimum level.</p>
  </fieldset>
  <fieldset {{#if busy}}disabled{{/if}}>
    <legend>Generation</legend>
    <div class="carbon-grid">
      <label>Minimum level<input type="number" name="minLevel" value="{{values.minLevel}}" min="1" max="100" step="1" required></label>
      <label>Maximum level<input type="number" name="maxLevel" value="{{values.maxLevel}}" min="1" max="100" step="1" required></label>
    </div>
    <div class="carbon-grid">
      <label>Nature<select name="nature"><option value="">Random nature (all 36)</option>{{#each natures}}<option {{#if selected}}selected{{/if}} value="{{value}}">{{value}}</option>{{/each}}</select></label>
      <label>Shiny chance (%)<input type="number" name="shinyChance" value="{{values.shinyChance}}" min="0" max="100" step="any" required></label>
      <label>Stat distribution<select name="statStyle">{{#each statStyles}}<option {{#if selected}}selected{{/if}} value="{{value}}">{{value}}</option>{{/each}}</select></label>
      <label>Natural moves<select name="moveStyle">{{#each moveStyles}}<option {{#if selected}}selected{{/if}} value="{{value}}">{{value}}</option>{{/each}}</select></label>
    </div>
    <p class="carbon-hint">Allocates every stat point while preserving Base Stat Relation. Abilities unlock at levels 1, 20 and 40. Up to six natural moves.</p>
  </fieldset>
  {{/if}}
  <div class="carbon-actions">
    <button type="submit" {{#if busy}}disabled{{/if}}><i class="fas fa-dice"></i> {{#if hasPreview}}Reroll preview{{else}}Preview encounter{{/if}}</button>
    <button type="button" data-action="create" {{#unless hasPreview}}disabled{{/unless}} {{#if busy}}disabled{{/if}}><i class="fas fa-user-plus"></i> Create actors</button>
  </div>
  <p class="carbon-status" role="status" aria-live="polite">{{message}}</p>
  {{#each batch}}
  <article class="carbon-preview">
    <img src="{{img}}" alt="{{name}}">
    <div><h3>{{name}} {{#if shiny}}✦ Shiny{{/if}}</h3>
      <p>Level {{level}} {{#unless trainer}}· {{nature}}{{/unless}} · {{gender}} {{#if form}}· {{form}}{{/if}} · {{hp}} HP</p>
      <p class="carbon-stats">{{stats}}</p>
      {{#if trainer}}
      <p><strong>Features:</strong> {{features}}</p>
      <p><strong>Edges:</strong> {{edges}}</p>
      <p><a href="{{artSource}}" target="_blank" rel="noopener noreferrer">Portrait and token artwork source</a></p>
      {{#if warnings}}<p role="alert"><strong>Carbon prerequisite warnings:</strong> {{warnings}}</p>{{/if}}
      {{else}}
      {{#if owner}}<p><strong>Trainer:</strong> {{owner}}</p>{{/if}}
      <p><strong>Abilities:</strong> {{abilities}}</p>
      <p><strong>Moves:</strong> {{moves}}</p>
      {{/if}}
    </div>
  </article>
  {{/each}}
  <footer class="carbon-credit">With thanks to <a href="https://github.com/animenerdfreddurst/pokemon_carbon" target="_blank" rel="noopener noreferrer">Trog / animenerdfreddurst</a> for making Pokémon Carbon a great Foundry VTT system.</footer>
</section>
